{
    "name": "@postalsys/email-content",
    "version": "0.1.16",
    "description": "Extract conversationally relevant content from arbitrary email messages",
    "keywords": [
        "email",
        "mime",
        "reply",
        "quote",
        "signature",
        "extraction",
        "parser"
    ],
    "license": "MIT",
    "author": "Postal Systems OÜ",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/email-content.git"
    },
    "bugs": {
        "url": "https://github.com/postalsys/email-content/issues"
    },
    "homepage": "https://github.com/postalsys/email-content#readme",
    "type": "commonjs",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "email-content": "dist/cli/main.js"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
        "build:test": "tsc -p tsconfig.test.json && node scripts/copy-assets.js && node scripts/copy-assets-test.js",
        "clean": "rm -rf dist .build-test",
        "typecheck": "tsc -p tsconfig.test.json --noEmit",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{js,cjs,ts,json,md}\"",
        "format:check": "prettier --check \"**/*.{js,cjs,ts,json,md}\"",
        "test": "npm run build:test && node --test .build-test/test/*.test.js",
        "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
        "test:fast": "node --test test/*.test.ts",
        "prepublishOnly": "npm run build",
        "cli": "node dist/cli/main.js",
        "verify:package": "node scripts/verify-package.js",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "dependencies": {
        "@zone-eu/mailsplit": "5.4.26",
        "libmime": "5.5.1",
        "node-html-parser": "9.0.4"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.5",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "mailparser": "3.9.45",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2"
    }
}
